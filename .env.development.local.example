# =============================================================================
# .env.development.local.example   →   copy to .env.development.local
#
# Local development against the Docker stack (`npx supabase start`). Next.js
# gives this file priority over .env.local in dev, so `npm run dev` uses it.
#
# The Supabase values are the LOCAL stack's — identical on every machine and
# NOT secret, so you may hard-code them in this .example if you want it
# copy-paste-ready. .env.development.local itself is gitignored.
# =============================================================================

# --- Local Supabase  (run `npx supabase status` and copy the values) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- AI  (optional locally; real key from Google AI Studio) ---
# Only needed to exercise the "Generate AI Schedule" feature.
GEMINI_API_KEY=

# --- E2E tests against the local stack (only needed to run `npm run test:e2e`) ---
# Dedicated test account, auto-created by e2e/auth.setup.ts on first run. Keep it
# separate from the seed demo accounts so tests don't clobber your demo data.
E2E_TEST_EMAIL=e2e@tourit.local
E2E_TEST_PASSWORD=e2e-password-123

# --- Google OAuth on the local stack (OPTIONAL / advanced) ---
# NOT needed for normal local dev — use the dev-only quick-login buttons instead.
# Only for testing the real Google sign-in flow locally, which also requires an
# [auth.external.google] block (client_id + skip_nonce_check = true) in
# supabase/config.toml. Note the standard var name (no "CLIENT_"):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=