# =============================================================================
# .env.local.example   →   copy to .env.local
#
# Points your LOCAL app at the REMOTE (hosted) Supabase project. OPTIONAL — only
# for when you deliberately want to develop against hosted data. For normal work
# use .env.development.local (the local Docker stack).
#
# Every value here is project-specific; the keys are sensitive. .env.local is
# gitignored — never commit the filled-in file.
# =============================================================================

# --- Supabase  (Dashboard → Project Settings → Data API / API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI  (Google AI Studio → https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=